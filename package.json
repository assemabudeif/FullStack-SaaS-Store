{
  "name": "advanced-store-saas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Multi-tenant store SaaS REST API",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.check.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "setup": "node scripts/setup.mjs",
    "docs:export": "tsx scripts/export-openapi.ts",
    "frontend:dev": "npm run dev --workspace=@storely/frontend",
    "frontend:build": "npm run build --workspace=@storely/frontend",
    "frontend:test": "npm run test --workspace=@storely/frontend",
    "dev:all": "concurrently -k -n api,web -c cyan,green \"npm run dev\" \"npm run frontend:dev\""
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.1.2",
    "@fastify/jwt": "^10.2.4",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@sinclair/typebox": "^0.34.52",
    "dotenv": "^18.0.7",
    "fastify": "^5.12.5",
    "handlebars": "^4.7.10",
    "nodemailer": "^10.0.16",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "workspaces": [
    "frontend"
  ]
}
