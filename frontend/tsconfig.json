{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "noUnusedLocals": true, "noUnusedParameters": true,
    "skipLibCheck": true, "noEmit": true, "allowImportingTsExtensions": true,
    "esModuleInterop": true, "resolveJsonModule": true, "types": ["vite/client"]
  },
  "include": ["src", "vite.config.ts", "tests", "playwright.config.ts"]
}
